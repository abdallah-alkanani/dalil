{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dalil:schema:quran_ref_index",
  "title": "Dalil quran reference",
  "description": "Cross-format Quran reference spine row. Links any source element/parent/view to a canonical surah:ayah or ayah range.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quran_ref_id",
    "surah",
    "ayah_start",
    "ayah_end",
    "source_kind",
    "source_id",
    "book_id",
    "match_method",
    "confidence",
    "matched_text",
    "quality_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "dalil.quran_ref_index.v1"
    },
    "quran_ref_id": {
      "type": "string",
      "pattern": "^qref:"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "ayah_start": {
      "type": "integer",
      "minimum": 1
    },
    "ayah_end": {
      "type": "integer",
      "minimum": 1
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "element",
        "parent",
        "retrieval_view"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^(elem:|parent:|view:)"
    },
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "match_method": {
      "type": "string",
      "enum": [
        "explicit_ref",
        "quoted_ayah_exact",
        "quoted_ayah_fuzzy",
        "source_structural_ref"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "matched_text": {
      "type": "string"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
