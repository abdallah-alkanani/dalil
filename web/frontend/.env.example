# The Daleel API (dalil-web/backend) and a user token for it (POST /auth/redeem).
DALEEL_API_URL=http://localhost:8000
DALEEL_TOKEN=
# The answer step runs here, so its system prompt can carry the OpenUI component library.
# Any OpenAI-compatible endpoint. Default: DeepSeek 4.1 Flash on Ollama Cloud (as Hermes).
ANSWER_BASE_URL=https://ollama.com/v1
ANSWER_API_KEY=
ANSWER_MODEL=deepseek-v4.1-flash:1017
# none | low | medium | high; empty sends nothing (OpenRouter models)
ANSWER_REASONING_EFFORT=none
# OpenRouter instead: ANSWER_BASE_URL=https://openrouter.ai/api/v1, ANSWER_MODEL=anthropic/claude-sonnet-5.5
# OpenUI's runtime telemetry
OPENUI_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
