# The dalil API (web/backend). The site is open to everyone; the API's daily cap
# for the whole site applies to every question.
DALIL_API_URL=http://localhost:8000
# The API's SITE_TOKEN: the API takes visitors only from this server.
SITE_TOKEN=
# OpenUI telemetry
OPENUI_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
