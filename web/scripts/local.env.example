# Copy to ~/.config/dalil/local.env (chmod 600) for web/scripts/up.sh and check.sh.
# It holds secrets and paths on this machine; it is not part of the repository.

# The search stores are in $DALIL_DATA_DIR/db. On an external drive this is the path
# under /Volumes; up.sh stops with a clear message when it is not mounted.
DALIL_DATA_DIR=
# Optional: a .env on the data drive to copy OPENROUTER_API_KEY from, once, when it is
# missing here.
DALIL_KEYS_FROM=

# Keep these on the internal disk, not on the data drive and not in /tmp.
DATABASE_URL=sqlite:///$HOME/.local/share/dalil/app.sqlite
GEOIP_DB=$HOME/.local/share/dalil/country.mmdb

SITE_TOKEN=
ADMIN_TOKEN=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
DALIL_DENSE_COMPACT_DIMS=1024

API_PORT=8000
SITE_PORT=3300
# Optional: the ngrok URL that serves the site (ngrok http --url).
PUBLIC_URL=
