# Copy to .env and fill in only what you use. Never commit .env.

# Query embeddings, the query planner and the listwise reranker (dalil.search),
# and the openrouter LLM transport. May also live in ~/.config/openrouter.key.
OPENROUTER_API_KEY=

# Only for the ollama_cloud LLM transport (dalil.llm).
OLLAMA_API_KEY=

# Optional: where the data directory lives (default: ./data)
# DALIL_DATA_DIR=
